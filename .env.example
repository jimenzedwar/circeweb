# Copia este archivo como .env.local y completa con los datos de tu proyecto de Supabase
# (Supabase → Project Settings → API).
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_tu-clave

# Dirección pública de la web (para SEO y vistas previas al compartir).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
